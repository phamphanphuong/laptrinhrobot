          class="w-full h-32 object-cover rounded-xl border border-gray-200 shadow-sm">
        <img src="images/seo/faq-coding.webp" width="700" height="467" alt="Học viên thực hành viết code trên máy tính"
          loading="lazy" decoding="async" class="w-full h-32 object-cover rounded-xl border border-gray-200 shadow-sm">
      </div>

      <!-- AlpineJS Accordion -->
      <div class="space-y-4" x-data="{ selected: 1 }">
        <!-- FAQ 1 -->
        <div
          class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-primary-300 transition-colors shadow-sm">
          <button @click="selected !== 1 ? selected = 1 : selected = null"
            class="w-full px-6 py-5 text-left flex justify-between items-center focus:outline-none">
            <span class="font-bold text-gray-900 md:text-lg">"Con tôi học xong sẽ làm được gì?"</span>
            <i class="fa-solid fa-chevron-down text-primary-500 transition-transform duration-300"
              :class="selected === 1 ? 'transform rotate-180' : ''"></i>
          </button>
          <div x-show="selected === 1" x-collapse x-cloak>
            <div
              class="px-6 pb-5 pt-0 text-gray-600 border-t border-gray-50 text-base leading-relaxed bg-gray-50/50 mt-4">
              Con không chỉ biết tiêu thụ công nghệ (chơi game), mà còn biết cách tự tạo ra sản phẩm thực tế (Làm Game,
              App, Robot, Web). Đặc biệt, con sẽ được trang bị tư duy hệ thống và logic để giải quyết các vấn đề phức
              tạp trong học tập và xã hội.
            </div>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div
          class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-primary-300 transition-colors shadow-sm">
          <button @click="selected !== 2 ? selected = 2 : selected = null"
            class="w-full px-6 py-5 text-left flex justify-between items-center focus:outline-none">
            <span class="font-bold text-gray-900 md:text-lg">"Chứng chỉ có giá trị thực sự không?"</span>
            <i class="fa-solid fa-chevron-down text-primary-500 transition-transform duration-300"
              :class="selected === 2 ? 'transform rotate-180' : ''"></i>
          </button>
          <div x-show="selected === 2" x-collapse x-cloak>
            <div
              class="px-6 pb-5 pt-0 text-gray-600 border-t border-gray-50 text-base leading-relaxed bg-gray-50/50 mt-4">
              Tuyệt đối có. Mọi chứng chỉ trung tâm hướng tới (từ Python Institute, Microsoft, College Board) đều là
              chứng chỉ Quốc tế có mã định danh có thể kiểm tra trực tuyến toàn cầu. Thay vì bỏ số tiền lớn cho các khóa
              học không bằng cấp, đây là khoản đầu tư vào chứng chỉ học thuật thật sự có tính ứng dụng cao.
            </div>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div
          class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-primary-300 transition-colors shadow-sm">
          <button @click="selected !== 3 ? selected = 3 : selected = null"
            class="w-full px-6 py-5 text-left flex justify-between items-center focus:outline-none">
            <span class="font-bold text-gray-900 md:text-lg">"Khoản đầu tư này mang lại lợi ích gì về tài chính?"</span>
            <i class="fa-solid fa-chevron-down text-primary-500 transition-transform duration-300"
              :class="selected === 3 ? 'transform rotate-180' : ''"></i>
          </button>
          <div x-show="selected === 3" x-collapse x-cloak>
            <div
              class="px-6 pb-5 pt-0 text-gray-600 border-t border-gray-50 text-base leading-relaxed bg-gray-50/50 mt-4">
              Học với người hướng dẫn sát sao sẽ đảm bảo cho các bé không bỏ cuộc nửa chừng, tránh đi sai hướng hoặc học
              những kiến thức vô bổ. Điều này giúp gia đình tiết kiệm tiền bạc, tối ưu thời gian, đặc biệt là tận dụng
              tuyệt đối "thời điểm vàng" lứa tuổi khi trẻ tiếp thu kiến thức tốt nhất. Ngoài ra, các chứng chỉ quốc tế
              như AP cũng giúp tiết kiệm một khoản chi phí đáng kể khi quy đổi tín chỉ tại các đại học Âu - Mỹ.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

