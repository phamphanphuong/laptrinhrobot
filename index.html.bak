          </ul>
        </div>

        <!-- Form Side -->
        <div class="lg:w-7/12 p-10 md:p-12 bg-white">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-bold text-gray-900">Đăng Ký Tư Vấn 1-1</h3>
            <p class="text-gray-500 mt-2">Điền thông tin để chuyên gia của chúng tôi gọi lại cho bạn</p>
          </div>

          <form id="registrationForm" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">Họ và tên Phụ huynh *</label>
                <input type="text" id="name" name="name"
                  class="w-full px-4 py-3 min-h-[48px] rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors bg-gray-50 text-gray-900 text-base"
                  placeholder="Nhập họ và tên" required>
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">Số điện thoại Zalo *</label>
                <input type="tel" id="phone" name="phone" inputmode="numeric" pattern="[0-9]*"
                  class="w-full px-4 py-3 min-h-[48px] rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors bg-gray-50 text-gray-900 text-base"
                  placeholder="Số điện thoại Zalo của phụ huynh" required>
              </div>
            </div>

            <div>
              <label for="age" class="block text-sm font-semibold text-gray-700 mb-1.5">Độ tuổi của con *</label>
              <div class="relative">
                <select id="age" name="age"
                  class="w-full px-4 py-3 min-h-[48px] rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 appearance-none transition-colors bg-gray-50 text-gray-900 text-base"
                  required>
                  <option value="" disabled selected>-- Chọn độ tuổi của con --</option>
                  <option value="7-9">7 - 9 tuổi (Khởi động)</option>
                  <option value="10-13">10 - 13 tuổi (Đam mê)</option>
                  <option value="13-15">13 - 15 tuổi (Chuyên nghiệp)</option>
                  <option value="15-18">15 - 18 tuổi (Nền tảng Đại học)</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                  <i class="fa-solid fa-chevron-down text-sm"></i>
                </div>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">Lời nhắn (Tùy chọn)</label>
              <textarea id="message" name="message" rows="2" maxlength="100"
                class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors bg-gray-50 text-gray-900 text-base resize-none"
                placeholder="Để lại lời nhắn (tối đa 20 từ)"></textarea>
            </div>

            <button type="submit" id="submitBtn"
              class="w-full min-h-[50px] bg-accent-500 hover:bg-accent-600 active:scale-[0.98] text-white font-bold py-3.5 px-8 rounded-xl shadow-lg hover:shadow-xl transition-all text-base md:text-lg flex items-center justify-center">
              <span id="btnText">TIẾN HÀNH ĐĂNG KÝ</span>
              <svg id="btnSpinner" class="animate-spin ml-3 h-5 w-5 text-white hidden"
                xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                </path>
              </svg>
            </button>
            <p class="text-xs text-center text-gray-500 mt-3">🔒 Thông tin của bạn được bảo mật tuyệt đối.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

