</head>

<body class="font-sans text-gray-800 antialiased bg-gray-50 overflow-x-hidden" x-data="{ mobileMenuOpen: false }">

  <!-- NAVIGATION -->
  <header class="fixed w-full top-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center cursor-pointer" onclick="window.scrollTo(0,0)">
          <div
            class="w-10 h-10 rounded-lg bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center text-white font-bold text-xl mr-3 shadow-lg">
            <i class="fa-solid fa-robot"></i>
          </div>
          <span class="font-bold text-xl md:text-2xl tracking-tight text-gray-900">Lập Trình <span
              class="text-primary-600">Robot</span></span>
        </div>

        <!-- Navigation Links -->
        <nav class="hidden md:flex space-x-7 items-center">
          <a href="#triet-ly" class="text-gray-600 hover:text-primary-600 font-medium transition-colors">Triết Lý</a>
          <a href="#lo-trinh" class="text-gray-600 hover:text-primary-600 font-medium transition-colors">Lộ Trình</a>
          <a href="#chuyen-gia" class="text-gray-600 hover:text-primary-600 font-medium transition-colors">Chuyên Gia</a>

          <!-- Khóa Học Chuyên Đề Dropdown -->
          <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
            <button @click="open = !open" type="button"
              class="inline-flex items-center gap-1.5 text-gray-600 hover:text-primary-600 font-medium transition-colors focus:outline-none py-2"
              :class="{ 'text-primary-600': open }">
              <span>Khóa Học Chuyên Đề</span>
              <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200" :class="{ 'rotate-180': open }"></i>
            </button>

            <!-- Dropdown Menu Panel -->
            <div x-show="open"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 translate-y-2 scale-95"
              x-transition:enter-end="opacity-100 translate-y-0 scale-100"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0 scale-100"
              x-transition:leave-end="opacity-0 translate-y-2 scale-95"
              class="absolute left-0 mt-2 w-80 rounded-2xl bg-white shadow-2xl border border-gray-100 p-2 z-50 ring-1 ring-black/5"
              x-cloak>
              <div class="px-3 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                Chuyên Đề Trọng Điểm
              </div>

              <!-- Item 1: Chuyên Tin 10 C++ -->
              <a href="tin10.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-primary-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center shrink-0 group-hover:bg-primary-600 group-hover:text-white transition-colors">
                  <i class="fa-solid fa-code text-base"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-primary-600 text-sm flex items-center gap-1.5">
                    Chuyên Tin 10 (C++)
                    <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-primary-100 text-primary-700">Hot</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">48 buổi luyện thi thuật toán & kho 27 đề thực tế</div>
                </div>
              </a>

              <!-- Item 2: Vật Lý & KHTN IGCSE -->
              <a href="physics.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-emerald-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                  <i class="fa-solid fa-flask text-base"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-emerald-600 text-sm">Khoa Học & Vật Lý IGCSE</div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">Thực nghiệm cảm biến IoT & tư duy dữ liệu</div>
                </div>
              </a>

              <!-- Item 3: Python Xây Dựng -->
              <a href="python-xay-dung/index.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-amber-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center shrink-0 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                  <i class="fa-solid fa-helmet-safety text-base"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-amber-600 text-sm flex items-center gap-1.5">
                    Python Xây Dựng
                    <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">Thực chiến</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">32 buổi: Dự toán, Mini-CRM & Streamlit App</div>
                </div>
              </a>

              <!-- Item 4: Giáo Trình Scratch 3.0 -->
              <a href="scratch_curriculum_portal.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-orange-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center shrink-0 group-hover:bg-orange-600 group-hover:text-white transition-colors">
                  <i class="fa-solid fa-cat text-base"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-orange-600 text-sm flex items-center gap-1.5">
                    Scratch 3.0
                    <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-orange-100 text-orange-700">7-10T</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">24 buổi chuẩn MIT: Game 2D & hoạt hình tương tác</div>
                </div>
              </a>

              <!-- Item 5: Giáo Trình WeDo 2.0 -->
              <a href="wedo_2_0_curriculum_portal.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-red-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-red-100 text-red-600 flex items-center justify-center shrink-0 group-hover:bg-red-600 group-hover:text-white transition-colors">
                  <i class="fa-solid fa-cubes text-base"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-red-600 text-sm flex items-center gap-1.5">
                    Lego WeDo 2.0
                    <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-red-100 text-red-700">7-10T</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">16 buổi chuẩn NGSS & mô phỏng tiết học mẫu</div>
                </div>
              </a>

              <!-- Item 6: Giáo Trình Python & Pygame -->
              <a href="pygame_curriculum_portal.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-blue-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-blue-100 text-python-blue flex items-center justify-center shrink-0 group-hover:bg-python-blue group-hover:text-white transition-colors">
                  <i class="fa-brands fa-python text-lg"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-python-blue text-sm flex items-center gap-1.5">
                    Python & Pygame
                    <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-blue-100 text-blue-800">10-14T</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">24 buổi: Game 2D, OOP & mô phỏng code IDE</div>
                </div>
              </a>

              <!-- Item 7: Giáo Trình ESP32 & IoT MicroPython -->
              <a href="esp32_iot_curriculum_portal.html"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-cyan-50/70 transition-colors group">
                <div class="w-9 h-9 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center shrink-0 group-hover:bg-cyan-600 group-hover:text-white transition-colors">
                  <i class="fa-solid fa-microchip text-base"></i>
                </div>
                <div>
                  <div class="font-semibold text-gray-900 group-hover:text-cyan-600 text-sm flex items-center gap-1.5">
                    ESP32 & IoT MicroPython
                    <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-cyan-100 text-cyan-800">13-18T</span>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 leading-tight">48 buổi: Thonny IDE, Web Server, MQTT & Smart Home</div>
                </div>
              </a>

              <!-- Quick divider and link to competition -->
              <div class="border-t border-gray-100 mt-1 pt-1">
                <a href="competition.html"
                  class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:text-primary-600 hover:bg-gray-50 transition-colors">
                  <span><i class="fa-solid fa-book mr-1.5 text-gray-400"></i>Thư viện đề thi Chuyên Tin</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>
            </div>
          </div>

          <a href="lien-he.html" class="text-gray-600 hover:text-primary-600 font-medium transition-colors">Liên Hệ</a>
        </nav>

        <!-- CTA Button -->
        <div class="hidden md:flex items-center">
          <a href="#dang-ky"
            class="inline-flex items-center justify-center px-6 py-2.5 border border-transparent text-sm font-semibold rounded-full shadow-md text-white bg-secondary-600 hover:bg-secondary-700 hover:shadow-lg transition-all transform hover:-translate-y-0.5">
            ĐĂNG KÝ
          </a>
        </div>

        <!-- Mobile menu button -->
        <div class="flex items-center md:hidden">
          <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" aria-label="Mở menu"
            class="min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-700 hover:text-gray-900 rounded-xl hover:bg-gray-100 active:bg-gray-200 transition-colors p-2.5">
            <i class="fa-solid fa-bars text-2xl" x-show="!mobileMenuOpen"></i>
            <i class="fa-solid fa-xmark text-2xl" x-show="mobileMenuOpen" x-cloak></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Backdrop Overlay -->
    <div x-show="mobileMenuOpen"
      x-transition:enter="transition-opacity ease-linear duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition-opacity ease-linear duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 md:hidden"
      @click="mobileMenuOpen = false"
      x-cloak>
    </div>

    <!-- Mobile Drawer (85% width slide-over from right) -->
    <div x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      class="fixed top-0 right-0 bottom-0 w-[85%] max-w-sm bg-white shadow-2xl z-50 flex flex-col h-full md:hidden"
      x-data="{ coursesOpen: false }"
      x-cloak>
      
      <!-- Drawer Header with 44x44 Close Button -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 shrink-0">
        <div class="flex items-center cursor-pointer" @click="window.scrollTo(0,0); mobileMenuOpen = false">
          <div
            class="w-9 h-9 rounded-lg bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center text-white font-bold text-lg mr-2.5 shadow-sm">
            <i class="fa-solid fa-robot"></i>
          </div>
          <span class="font-bold text-lg text-gray-900 tracking-tight">Lập Trình <span
              class="text-primary-600">Robot</span></span>
