        <div
          class="lg:w-5/12 bg-secondary-600 p-10 md:p-12 text-white flex flex-col justify-center relative overflow-hidden">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl"></div>
