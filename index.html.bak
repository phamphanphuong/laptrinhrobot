  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "EducationalOrganization",
        "@id": "https://laptrinhrobot.com/#organization",
        "name": "Lập Trình Robot",
        "url": "https://laptrinhrobot.com/",
        "logo": "https://laptrinhrobot.com/favicon.svg",
        "image": "https://laptrinhrobot.com/images/seo/class.webp",
        "description": "Chương trình đào tạo lập trình, robotics, khoa học máy tính và AI cho trẻ em 7-18 tuổi.",
        "telephone": "0915514419",
        "email": "LapTrinhRobot.com@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Hẻm 556 Nguyễn Văn Quá, số nhà 12/5, phường Đông Hưng Thuận (quận 12)",
          "addressLocality": "TP. HCM",
          "addressCountry": "VN"
        },
        "sameAs": [
          "https://facebook.com/laptrinhrobots",
          "https://youtube.com/@LapTrinhROBOT_com"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://laptrinhrobot.com/#website",
        "url": "https://laptrinhrobot.com/",
        "name": "Lập Trình Robot",
        "inLanguage": "vi-VN",
        "publisher": {
          "@id": "https://laptrinhrobot.com/#organization"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://laptrinhrobot.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Con tôi học xong sẽ làm được gì?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Con không chỉ biết tiêu thụ công nghệ mà còn có thể tự tạo ra sản phẩm thực tế như game, app, robot và web; đồng thời phát triển tư duy hệ thống và logic giải quyết vấn đề."
            }
          },
          {
            "@type": "Question",
            "name": "Chứng chỉ có giá trị thực sự không?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Các chứng chỉ hướng tới từ Python Institute, Microsoft và College Board đều là chứng chỉ quốc tế có mã định danh và có thể kiểm tra trực tuyến toàn cầu."
            }
          },
          {
            "@type": "Question",
            "name": "Khoản đầu tư này mang lại lợi ích gì về tài chính?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Lộ trình học đúng và có người hướng dẫn sát sao giúp tiết kiệm thời gian, chi phí học sai hướng và tận dụng thời điểm vàng phát triển của trẻ; đồng thời các chứng chỉ quốc tế như AP có thể hỗ trợ quy đổi tín chỉ đại học."
            }
          }
        ]
      }
    ]
  }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
